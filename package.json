{
  "name": "流畅阅读",
  "description": "一款革命性的浏览器开源翻译插件，让所有人都能够拥有母语般的阅读体验",
  "private": true,
  "version": "0.0.31",
  "userscriptVersion": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:userscript": "vite build --config userscript/vite.config.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:regression:all": "node scripts/testing/run-full-regression.mjs",
    "verify:extension-manifests": "node scripts/testing/verify-extension-manifests.mjs",
    "test:document": "vitest run tests/documentTranslation.test.ts tests/documentTranslationApi.test.ts tests/documentTranslationBinary.test.ts tests/documentTranslationExamplesApi.test.ts tests/documentTranslationPresentation.test.ts tests/documentTranslationRegression.test.ts",
    "test:translation-core": "vitest run tests/translationCore.test.ts tests/translationState.test.ts tests/serializationPerformance.test.ts tests/translateApiPerformance.test.ts tests/translateQueue.test.ts tests/pageContext.test.ts tests/pageContextDefuddle.test.ts",
    "test:selection-triggers": "node scripts/run-selection-trigger-test.cjs",
    "test:translation-sites": "node scripts/run-site-translation-matrix.cjs",
    "test:video:fixture": "node scripts/run-video-subtitle-fixture-test.cjs",
    "test:watch": "vitest",
    "test:userscript": "pnpm build:userscript && node scripts/verify-userscript-build.mjs",
    "postinstall": "wxt prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.39",
    "@lucide/vue": "1.34.0",
    "@noble/hashes": "2.3.0",
    "@wxt-dev/storage": "1.2.9",
    "ai": "7.0.83",
    "defuddle": "0.19.3",
    "dexie": "4.4.5",
    "element-plus": "2.14.5",
    "franc-min": "6.2.0",
    "jszip": "3.10.1",
    "lucide": "1.34.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "sortablejs": "1.15.7",
    "tesseract.js": "7.0.0",
    "thesvg": "3.3.1",
    "tldts": "7.4.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "0.2.7",
    "@types/node": "22.20.1",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "linkedom": "0.18.13",
    "sharp": "0.35.4",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-image-optimizer": "2.0.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.0.0"
}
